<UserControl x:Class="PulseWatch.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PulseWatch.Views">
    <Grid Margin="24,6,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.05*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="14,14,8,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,6,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{v:T He=אפס מינימום/מקסימום, En=Reset min/max}" Click="ResetMinMax_Click" Padding="10,5" FontSize="12"/>
                        <Grid Margin="0,0,10,0">
                            <TextBox x:Name="Search" TextChanged="Search_TextChanged" Padding="30,6,8,6"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <RadioButton Style="{StaticResource Chip}" GroupName="tf" Content="{v:T He=עיקריים, En=Key sensors}" Tag="key" IsChecked="True" Checked="Type_Checked" Padding="10,4" ToolTip="{v:T He=רק החיישנים החשובים — בלי 60 השורות החוזרות של כל ליבה, En=Only the sensors that matter — without the 60 repeated per-core rows}"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="tf" Content="{v:T He=הכל, En=All}" Tag="" Checked="Type_Checked" Padding="10,4"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="tf" Content="{v:T He=טמפרטורות, En=Temperatures}" Tag="Temperature" Checked="Type_Checked" Padding="10,4"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="tf" Content="{v:T He=מאווררים, En=Fans}" Tag="Fan,Control" Checked="Type_Checked" Padding="10,4"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="tf" Content="{v:T He=מתחים, En=Voltages}" Tag="Voltage,Current" Checked="Type_Checked" Padding="10,4"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="tf" Content="{v:T He=הספק, En=Power}" Tag="Power" Checked="Type_Checked" Padding="10,4"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="tf" Content="{v:T He=תדרים, En=Clocks}" Tag="Clock" Checked="Type_Checked" Padding="10,4"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="tf" Content="{v:T He=עומסים, En=Loads}" Tag="Load,Level" Checked="Type_Checked" Padding="10,4"/>
                    </WrapPanel>
                    <Grid Margin="34,12,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{v:T He=חיישן (לחץ על השם כדי לשנות · רחף להסבר), En=Sensor (click a name to rename · hover for details)}" Style="{StaticResource Caption}" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{v:T He=עכשיו, En=Now}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="{v:T He=מינימום, En=Min}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="{v:T He=מקסימום, En=Max}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
                <ListBox x:Name="List" Background="Transparent" Foreground="{StaticResource Text}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="4,14,0,4" FontSize="13"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" CornerRadius="6" Padding="4,3" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource HoverSoft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Help}" ToolTipService.InitialShowDelay="400">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="64"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Pinned}" VerticalAlignment="Center">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <TextBlock x:Name="star" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Faint}" Background="Transparent" Cursor="Hand" Padding="4"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="star" Property="Text" Value="&#xE735;"/>
                                                    <Setter TargetName="star" Property="Foreground" Value="{StaticResource Warn}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Background="Transparent" BorderThickness="0" Padding="0" FontSize="12.5" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{Binding ValueBrush}" Style="{StaticResource Num}" FontSize="12.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Min}" Style="{StaticResource Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Max}" Style="{StaticResource Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <RadioButton Style="{StaticResource Chip}" GroupName="gs" Content="{v:T He=דקה, En=1 min}" Tag="60" Checked="Span_Checked" Padding="10,3"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="gs" Content="{v:T He=5 דקות, En=5 min}" Tag="300" Checked="Span_Checked" Padding="10,3"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="gs" Content="{v:T He=15 דקות, En=15 min}" Tag="900" Checked="Span_Checked" Padding="10,3" IsChecked="True"/>
                        <RadioButton Style="{StaticResource Chip}" GroupName="gs" Content="{v:T He=שעה, En=1 hour}" Tag="3600" Checked="Span_Checked" Padding="10,3"/>
                        <Button Style="{StaticResource IconBtn}" Content="&#xE896;" ToolTip="{v:T He=ייצוא ל-CSV, En=Export to CSV}" Click="Export_Click" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{v:T He=גרף חיישנים מסומנים, En=Starred sensors}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="EmptyHint" Style="{StaticResource Hint}" Text="{v:T He=סמן ★ ליד חיישנים כדי להוסיף אותם לגרף. חיישנים עם אותה יחידה מוצגים יחד. לחיצה על שם בתחתית הגרף מסתירה קו · לחיצה כפולה מבודדת אותו., En=Star ★ sensors to graph them. Sensors with the same unit share a chart. Click a name under a chart to hide its line · double-click to isolate it.}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Charts"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
